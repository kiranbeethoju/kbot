{
  "name": "kbot",
  "displayName": "KBot",
  "description": "Cursor-like AI coding assistant powered by Azure OpenAI (GPT-5, GPT-4, GPT-4o), NVIDIA, Anthropic Foundry, and Z.AI. 100% local - no telemetry, no cloud storage. Your code never leaves your machine except for AI provider API calls. Now with intelligent orchestration layer for handling large codebases and long conversations.",
  "version": "1.9.0",
  "publisher": "KiranBeethojuAIplugins",
  "author": "Kiran Beethoju",
  "license": "MIT",
  "icon": "kbot.png",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "azure",
    "openai",
    "nvidia",
    "anthropic",
    "zai",
    "glm",
    "claude",
    "ai",
    "assistant",
    "chat",
    "coding"
  ],
  "activationEvents": [
    "onCommand:kbot.openChat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kbot.openChat",
        "title": "Open KBot Chat",
        "category": "KBot"
      },
      {
        "command": "kbot.configureCredentials",
        "title": "Configure KBot Credentials",
        "category": "KBot"
      },
      {
        "command": "kbot.showLogs",
        "title": "Show KBot Logs",
        "category": "KBot"
      },
      {
        "command": "kbot.manageExclusions",
        "title": "Manage File Exclusions",
        "category": "KBot"
      },
      {
        "command": "kbot.configureSystemPrompts",
        "title": "Configure System Prompts",
        "category": "KBot"
      },
      {
        "command": "kbot.configureWorkspace",
        "title": "Configure Workspace Directory",
        "category": "KBot"
      },
      {
        "command": "kbot.configureGitHub",
        "title": "Configure GitHub",
        "category": "KBot"
      },
      {
        "command": "kbot.detectGitHubRepo",
        "title": "Detect GitHub Repository",
        "category": "KBot"
      },
      {
        "command": "kbot.runCodeReview",
        "title": "Run AI Code Review",
        "category": "KBot"
      },
      {
        "command": "kbot.manageReviewConfigs",
        "title": "Manage Review Configurations",
        "category": "KBot"
      },
      {
        "command": "kbot.clearReviewDecorations",
        "title": "Clear Review Annotations",
        "category": "KBot"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kbot-sidebar",
          "title": "KBot",
          "icon": "kbot.png"
        }
      ]
    },
    "views": {
      "kbot-sidebar": [
        {
          "type": "webview",
          "id": "kbotChatView",
          "name": "Chat",
          "contextualTitle": "KBot Chat"
        },
        {
          "type": "webview",
          "id": "kbotCredentialsView",
          "name": "Credentials",
          "contextualTitle": "KBot Credentials"
        },
        {
          "type": "webview",
          "id": "kbotHistoryView",
          "name": "History",
          "contextualTitle": "KBot Chat History"
        }
      ]
    },
    "configuration": {
      "title": "KBot",
      "properties": {
        "azureGpt.enableOrchestration": {
          "type": "boolean",
          "default": false,
          "description": "Enable intelligent orchestration layer with context management, summarization, and memory retrieval for improved handling of large files and long conversations."
        },
        "azureGpt.maxFileContextTokens": {
          "type": "number",
          "default": 8000,
          "description": "Maximum tokens to use for file context before triggering summarization."
        },
        "azureGpt.enableMemoryRetrieval": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic memory retrieval for relevant context from previous conversations."
        },
        "kbot.codeReview.useCustomConfig": {
          "type": "boolean",
          "default": false,
          "description": "Use custom review rules from .kbot/checks/*.md files."
        },
        "kbot.codeReview.reviewAllFiles": {
          "type": "boolean",
          "default": false,
          "description": "Review all files in the repository (vs. only staged changes)."
        },
        "kbot.codeReview.includeContext": {
          "type": "number",
          "default": 3,
          "description": "Number of lines of context to include in review comments."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:@octokit/rest --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:@octokit/rest --format=cjs --platform=node --watch",
    "package": "vsce package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kiranbeethoju/kbot"
  },
  "bugs": {
    "url": "https://github.com/kiranbeethoju/kbot/issues"
  },
  "homepage": "https://github.com/kiranbeethoju/kbot#readme",
  "dependencies": {
    "@octokit/rest": "^21.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.20.0"
  }
}
